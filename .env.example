# =============================================================
#  O SEGREDO DOS 900+  —  Variáveis de ambiente (exemplo)
#  Copie este arquivo para .env e preencha com os valores reais
# =============================================================

# ---- Mercado Pago -----------------------------------------------------
# Access Token de produção (Painel Mercado Pago > Seus integrações > Credenciais)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxx-xxxxx-xxxxxxx

# Secret do webhook (recomendado). Criado nas credenciais do Marketplace / Integrations
WEBHOOK_SECRET=webhook_secret_opcional

# ---- Vercel KV (Upstash Redis) ---------------------------------------
# Ao criar "Storage > KV" na Vercel, estas variáveis são geradas automaticamente.
# Necessárias para: alunos, tokens, sessões e controle de duplicidade de pagamento.
KV_REST_API_URL=https://xxxxxxx.upstash.io
KV_REST_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Resend (e-mail) --------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="O Segredo dos 900+ <contato@seudominio.com.br>"

# ---- App --------------------------------------------------------------
# URL pública da aplicação (ex: https://osegredodos900mais.vercel.app)
APP_URL=https://osegredodos900mais.vercel.app

# Chave usada para reenvio manual de token pelo endpoint /api/email/enviar-token
ADMIN_KEY=troque-esta-chave-admin